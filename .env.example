# MarketLens frontend configuration
# Copy to .env.local and fill in values. Only VITE_* variables are exposed to the browser.
# NEVER put private keys or server-side API secrets here. Privileged calls must go through a backend.

# ── Data backend (server/) ─────────────────────────────────────────────────────────────
# Run `npm run server` (or `npm run dev:all`) and point these at it. The backend holds vendor
# keys; the browser never talks to Yahoo/Finnhub/SEC directly. In production replace the host
# with your deployed API URL, e.g. https://api.yourdomain.com/market
VITE_MARKET_API_URL=http://localhost:8787/market
VITE_NEWS_API_URL=http://localhost:8787/news
VITE_FILINGS_API_URL=http://localhost:8787/filings
VITE_ANALYTICS_API_URL=http://localhost:8787/analytics

# ── Rewards / on-chain (not part of server/ yet — see docs/CONFIGURATION.md) ───────────
# Rewards backend (claimable balances, history, protocol/keeper status)
VITE_REWARDS_API_URL=

# Alerts backend
VITE_ALERTS_API_URL=

# Read-only rewards blockchain configuration belongs in server/.env, not VITE_*.
# Keep contract values blank until manually supplied by the operator.
# REWARD_CHAIN_ID=
# REWARD_RPC_URL=
# REWARD_AAPL_CONTRACT=
# REWARD_SPY_CONTRACT=
# REWARD_SPCX_CONTRACT=
# REWARD_AMZN_CONTRACT=
# REWARD_NVDA_CONTRACT=
# REWARD_TSLA_CONTRACT=

# Authenticated user backend (watchlist persistence). When unset, watchlist uses local dev storage only.
VITE_USER_API_URL=

# Blockchain
VITE_RPC_URL=
VITE_CHAIN_ID=
VITE_REWARD_CONTRACT_ADDRESS=
VITE_EXPLORER_URL=

# Community
VITE_X_URL=https://x.com/marketlens

# ── Official MarketLens token ("CA") ───────────────────────────────────────────────────
# Leave blank until launch: the site shows a "not launched yet" state, never a fake chart/CA.
VITE_TOKEN_ADDRESS=
VITE_TOKEN_CHAIN=            # DexScreener slug: solana | ethereum | base | bsc | arbitrum
VITE_TOKEN_SYMBOL=LENS
VITE_TOKEN_PAIR=             # optional DexScreener pair address for a cleaner chart
VITE_TOKEN_CHART_URL=        # optional: full embed URL to override the DexScreener default
